<?xml version="1.0" encoding="utf-8"?>
<!-- Feed por repositório: não herda o NuGet.config global da máquina (feeds de outros clientes, 401 etc.). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
