{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "./.cursor/hooks/protect-paths.sh",
        "matcher": "Write|Edit|MultiEdit|StrReplace|Delete|Read",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./.cursor/hooks/guard-bash.sh",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "./.cursor/hooks/protect-paths.sh",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "./.cursor/hooks/protect-paths.sh",
        "timeout": 10
      },
      {
        "command": "./.cursor/hooks/dotnet-format.sh",
        "timeout": 60
      }
    ]
  }
}
