<Project>
  <!-- Whitebeard · Agentic Engineering Kit — analyzers para todos os projetos do repo.
       Severidade se ajusta no .editorconfig, NUNCA com NoWarn no csproj. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Restore reproduzível: packages.lock.json versionado; no CI, o restore roda em modo bloqueado (locked mode) e falha se o lockfile não bater (issue #26). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- AnalysisLevel sem modo ("latest", não "latest-Recommended"): o valor composto tem precedência sobre AnalysisMode
         ("if you specify both properties, AnalysisLevel takes precedence over AnalysisMode", doc msbuild-props) e
         anulava a rampa por projeto — um csproj com AnalysisMode=Minimum compilava em Recommended (issue #25). O modo
         vem da linha AnalysisMode abaixo, e o projeto legado o sobrescreve. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (using desnecessário) só roda no build com doc file. CS1591 (falta xml-doc) é silenciado no .editorconfig, como toda severidade. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Rampa: Minimum → Recommended → All, um degrau por sprint. Novo serviço nasce em All. -->
    <AnalysisMode Condition="'$(AnalysisMode)' == ''">Recommended</AnalysisMode>
    <!-- Warnings de análise viram erro (o build é o que o agente obedece). Desligue por projeto só com justificativa em ADR. -->
    <CodeAnalysisTreatWarningsAsErrors Condition="'$(CodeAnalysisTreatWarningsAsErrors)' == ''">true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Legado (csproj não-SDK / .NET Framework): AnalysisLevel não é entendido. Use o pacote + EffectiveAnalysisLevel
       e comece em Minimum para não travar o build com milhares de warnings. -->
  <!--
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.*" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <EffectiveAnalysisLevel>9.0</EffectiveAnalysisLevel>
    <AnalysisMode>Minimum</AnalysisMode>
  </PropertyGroup>
  -->
</Project>
